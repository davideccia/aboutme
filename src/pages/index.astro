---
import '../styles/theme.css';

import data from '../content/data';
import { getCollection } from 'astro:content';

import Info from '../components/Info.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { Content as Summary } from '../content/summary.md';

const personalProjects = (await getCollection('personal_projects'))
  // sort by the file name
  .sort(({ id: a }, { id: b }) => (a < b ? -1 : a > b ? 1 : 0));

const copyrightProjects = (await getCollection('copyright_projects'))
  // sort by the file name
  .sort(({ id: a }, { id: b }) => (a < b ? -1 : a > b ? 1 : 0));

const work = (await getCollection('work'))
  // sort the work experiences in reverse chronological order
  .sort((a, b) => b.data.period.end.valueOf() - a.data.period.end.valueOf())
  .map((role, i, arr) => ({
    ...role,
    // render the company h3 heading if it’s the first role or if the role has a different company than the previous one
    displayCompanyHeading: i === 0 || arr[i]?.data.company !== arr[i - 1]?.data.company,
  }));
---

<html lang="en">
  <head>
    <title>{`Resume (${data.summary.name})`}</title>
    <meta name="description" content=`The resume for ${data.summary.name}, a ${data.summary.title}` />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="https://fav.farm/📝" />
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID} />
    )}
  </head>
  <main class="markdown-body">
    <header class="resume__header">
      <h1>{data.summary.name}</h1>

      <address>
        <Info href={data.summary.location.href} iconName="map-marker">{data.summary.location.title}</Info>
        { data.summary.phone ? <Info href=`tel:${data.summary.phone}` iconName="cellphone">{data.summary.phone}</Info> : null }
        <Info href=`mailto:${data.summary.email}` iconName="email">{data.summary.email}</Info>
        <Info href={data.summary.codeberg.href || 'https://codeberg.org'} iconName="codeberg"
          >{data.summary.codeberg.title || 'Codeberg'}</Info
        >
        <Info href={data.summary.github.href || 'https://github.com'} iconName="github"
          >{data.summary.github.title || 'GitHub'}</Info
        >
        <Info href={data.summary.linkedin.href || 'https://linkedin.com'} iconName="linkedin"
          >{data.summary.linkedin.title || 'LinkedIn'}</Info
        >
      </address>
    </header>

    <section>
      <h2>Summary</h2>
      <Summary />
    </section>

    <section class="resume__employment">
      <h2>Experience</h2>
      <dl>
        {
          work.map(job => (
            <div class="employment__role">
              {job.displayCompanyHeading && (
                <h3>
                  <span>{job.data.company}</span>
                </h3>
              )}
              <dt>
                <span>
                  <strong>{job.data.title}</strong>
                </span>

                <span class="resume__period">
                  <time>{job.data.period.raw}</time>
                </span>
              </dt>
              <dd set:html={job.rendered?.html} />
            </div>
          ))
        }
      </dl>
    </section>

    <section class="resume__stack">
      <h2>Stack</h2>
      <h3>Frameworks</h3>
      <p>
        {
          data.frameworksStack.map(skill => (
            <span class="skill__name">
              <SkillBadge name={skill.name} iconUrl={skill.icon} level={skill.level} />
            </span>
          ))
        }
      </p>
      <h3>Technologies</h3>
      <p>
        {
          data.techonologiesStack.map(skill => (
            <span class="skill__name">
              <SkillBadge name={skill.name} iconUrl={skill.icon} level={skill.level} />
            </span>
          ))
        }
      </p>
    </section>

    <section class="resume__projects">
      <h2>Projects</h2>
      <h3>Personal</h3>
      <dl>
        {
          personalProjects.map(project => (
            <div>
              <dt>
                <span>
                  <Info href={project.data.link} iconName={project.data.icon}>
                    <strong set:html={project.data.title} />
                  </Info>
                </span>
              </dt>
              <dd>
                <div class="project__description" set:html={project.rendered?.html} />
                {project.data.stack?.length ? (
                  <p>
                    {project.data.stack.map(skill => (
                      <span class="skill__name">
                        <code>{skill}</code>
                      </span>
                    ))}
                  </p>
                ) : null}
              </dd>
            </div>
          ))
        }
      </dl>
      <h3>Copyright</h3>
      <dl>
        {
          copyrightProjects.map(project => (
            <div>
              <dt>
                <span>
                  <Info href={project.data.link} iconName={project.data.icon}>
                    <strong set:html={project.data.title} />
                  </Info>
                </span>
              </dt>
              <dd>
                <div class="project__description" set:html={project.rendered?.html} />
                {project.data.stack?.length ? (
                  <p>
                    {project.data.stack.map(skill => (
                      <span class="skill__name">
                        <code>{skill}</code>
                      </span>
                    ))}
                  </p>
                ) : null}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="resume__education">
      <h2>Education</h2>
      <ol>
        {
          data.education.map(schooling => (
            <li>
              <span class="edu__heading">
                <strong>{schooling.institution}</strong>, {schooling.description}
              </span>
              <span class="resume__period">
                {schooling.period[0]} - {schooling.period[1]}
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <style is:global>
    :root {
      /* screen (dark) defaults; redefined for print below */
      --color-bg: #0b0c0e;
      --color-text: #e8e9ea;
      --color-text-muted: #9a9ea4;
      --color-text-subtle: #6d7076;
      --color-border: #2a2d31;
      --color-accent: #7ca6c7;

      --radius-sm: 0.375rem;
      --space-1: 0.25rem;
      --space-2: 0.5rem;
      --space-3: 0.75rem;
      --space-4: 1rem;
      --space-5: 1.5rem;
      --space-6: 2rem;
      --space-7: 3rem;

      --page-margin: 0.75in;
      --top-page-margin: 0.5in;
    }

    @media print {
      :root {
        --color-bg: #ffffff;
        --color-text: #1b1c1e;
        --color-text-muted: #55585e;
        --color-text-subtle: #77797e;
        --color-border: #d8d9db;
        --color-accent: #3e6786;
      }
    }

    html,
    body {
      margin: 0;
      background: var(--color-bg);
    }

    .markdown-body {
      margin: var(--page-margin) auto var(--page-margin);
      max-width: calc(8.5in - var(--page-margin) * 2);
      font-family: 'Geist Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      font-size: 15px;
      color: var(--color-text);
      background-color: var(--color-bg);

      b,
      strong {
        font-weight: 650;
      }
    }

    @media print {
      @page {
        margin: 0.5in;
        size: 8.5in 11in;
      }

      .markdown-body {
        margin: 0;
        max-width: 100%;
        font-size: 12px;
      }
    }

    @media screen and (width < 8.5in) {
      .markdown-body {
        margin: 10vw 20px;
      }

      .markdown-body .resume__header address {
        align-items: center;
        flex-direction: column;
        gap: 1em;
      }
    }

    .resume__header {
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-4);
      margin-bottom: var(--space-5);

      h1 {
        text-align: center;
        margin-top: 0px;
        margin-bottom: var(--space-3);
        font-weight: 650;
      }

      address {
        display: flex;
        justify-content: center;
        font-style: normal;
        gap: var(--space-5);
      }
    }

    .markdown-body h2 {
      font-size: 1.05rem;
      font-weight: 600;
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
    }

    .markdown-body dl dt {
      margin-top: var(--space-2);
    }

    .resume__stack {
      h3 {
        font-size: 0.85em;
        font-weight: 600;
        color: var(--color-text-muted);
      }

      ul {
        list-style: none;
        padding-inline-start: 0px;
      }

      p {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-3);
      }
    }

    .skill__name {
      font-size: 0.95em;
      code {
        text-wrap-mode: nowrap;
      }
    }

    .resume__employment {
      h3 {
        margin-top: var(--space-6);
      }

      .employment__role {
        margin-top: var(--space-4);
        padding-left: var(--space-3);
        border-left: 2px solid var(--color-border);
      }

      dl dt {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-3);
        flex-wrap: wrap;
      }

      dd {
        li {
          position: relative;
          list-style: none;
          margin-top: 0.25em;
        }

        li:before {
          position: absolute;
          color: var(--color-text-subtle);
          content: '•';
          left: -0.75em;
        }
      }

      dd > ul {
        /* necessary b/c we need to unset gfm padding for 1st level lists */
        padding-inline-start: 0em;
      }

      ul {
        /* necessary b/c we need to re-add some padding for >2nd level lists */
        padding-inline-start: 1em;
      }
    }

    .resume__period {
      font-style: italic;
      font-weight: 450;
      color: var(--color-text-subtle);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .resume__employment .employment__role,
    .resume__projects,
    .resume__education {
      break-inside: avoid-page;
    }

    .resume__employment,
    .resume__projects {
      dl dt {
        /* necessary b/c gfm has styles we want to unset */
        font-style: normal;
      }
    }

    .resume__projects {
      dl dd {
        padding-left: 0;
      }

      .project__description p {
        margin-bottom: 0.125em;
      }

      .skill__name code {
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        padding: 0.05em 0.4em;
        font-size: 0.85em;
        color: var(--color-text-muted);
      }
    }

    .resume__education {
      ol {
        padding-inline-start: 0px;
        list-style: none;
      }

      li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
    }

    .markdown-body a {
      text-decoration: none;
    }

    @media print {
      .markdown-body a {
        text-decoration: underline !important;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .resume__header address a,
      .resume__projects a {
        transition:
          color 140ms ease-out,
          opacity 140ms ease-out,
          transform 140ms ease-out;
      }

      .resume__header address a:hover,
      .resume__projects a:hover {
        color: var(--color-accent);
        transform: translateY(-1px);
      }
    }

    @media screen {
      .resume__header address a:hover,
      .resume__projects a:hover {
        text-decoration: underline;
      }
    }
  </style>


</html>
